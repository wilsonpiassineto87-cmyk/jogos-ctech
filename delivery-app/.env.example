# Copie para .env (na raiz do monorepo). O app web e o pacote db leem este arquivo.

# --- Banco (docker compose up -d) ---
# Em produção serverless: DATABASE_URL via pooler, DIRECT_URL direto (migrations).
DATABASE_URL="postgresql://delivery:delivery@localhost:5432/delivery?schema=public"
DIRECT_URL="postgresql://delivery:delivery@localhost:5432/delivery?schema=public"

# --- Redis (rate limit, geo dos entregadores) ---
REDIS_URL="redis://localhost:6379"

# --- Auth.js ---
# Gere com: npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Pagamentos ---
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Tempo real (Pusher) ---
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="sa1"

# --- Mapas ---
NEXT_PUBLIC_MAPBOX_TOKEN=""

# --- Loja única atendida pelo app (slug da tabela Store) ---
STORE_SLUG="pizzaria-do-bairro"

# --- Seed (somente desenvolvimento) ---
SEED_PASSWORD="delivery123"
