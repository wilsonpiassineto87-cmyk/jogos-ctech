// =============================================================================
// Delivery multi-tenant — schema do banco (PostgreSQL + Prisma)
//
// Convenções:
// - Valores monetários em centavos (Int)  -> sem erro de ponto flutuante.
// - Percentuais em basis points (Int)    -> 1200 = 12,00%.
// - Pedidos guardam "snapshots" (preço, nome do produto, endereço, comissão)
//   para que edições futuras no cardápio/endereço não alterem o histórico.
// - Tenant = Store. Todo dado do portal do restaurante é filtrado por storeId.
// =============================================================================

generator client {
  provider   = "prisma-client-js"
  // Gerado dentro do pacote (e não em node_modules/.prisma): com o layout do pnpm,
  // o OpenNext não encontra o `.prisma/client` ao empacotar para o Workers.
  output     = "../generated/client"
  // "client" = Prisma sem motor nativo (Rust): as consultas saem pelo driver adapter `pg`.
  // Necessário no Cloudflare Workers, que não tem disco para carregar o motor.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexão via pooler (PgBouncer / Neon / Supabase)
  directUrl = env("DIRECT_URL") // conexão direta, usada pelas migrations
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  MERCHANT // acesso ao portal do restaurante (lojas específicas via StoreMember)
  COURIER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum StoreStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  CLOSED
}

enum StoreMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum CourierStatus {
  PENDING_APPROVAL
  APPROVED
  SUSPENDED
  REJECTED
}

enum VehicleType {
  ON_FOOT
  BICYCLE
  MOTORCYCLE
  CAR
}

enum OrderStatus {
  PENDING_PAYMENT // aguardando confirmação do pagamento online
  PLACED // pago (ou dinheiro na entrega) e enviado ao restaurante
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED // recusado pelo restaurante
  CANCELLED // cancelado por cliente, admin ou timeout
}

enum DeliveryStatus {
  WAITING_COURIER
  ASSIGNED
  AT_STORE
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  MERCADO_PAGO
  OFFLINE // dinheiro / maquininha na entrega
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
}

enum PaymentStatus {
  PENDING
  PROCESSING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum NotificationType {
  ORDER_UPDATE
  DELIVERY_OFFER
  PROMOTION
  SYSTEM
}

// -----------------------------------------------------------------------------
// Usuários e autenticação (compatível com o Prisma Adapter do Auth.js)
// -----------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified DateTime?
  phone         String?    @unique
  passwordHash  String? // argon2id; nulo para login social / magic link
  image         String?
  roles         UserRole[] @default([CUSTOMER])
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime? // soft delete (LGPD: anonimizar em vez de apagar pedidos)

  accounts          Account[]
  sessions          Session[]
  addresses         Address[]
  storeMemberships  StoreMember[]
  courierProfile    CourierProfile?
  orders            Order[]              @relation("CustomerOrders")
  deliveries        Delivery[]           @relation("CourierDeliveries")
  reviews           Review[]
  statusChanges     OrderStatusHistory[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  auditLogs         AuditLog[]

  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String? // "Casa", "Trabalho"
  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String   @db.Char(2)
  reference    String?
  latitude     Float
  longitude    Float
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// -----------------------------------------------------------------------------
// Lojas (tenants)
// -----------------------------------------------------------------------------

model Store {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  logoUrl     String?
  bannerUrl   String?
  phone       String?
  legalName   String?
  taxId       String?     @unique // CNPJ / CPF
  status      StoreStatus @default(PENDING_APPROVAL)
  isOpen      Boolean     @default(false) // pausa manual, além do horário
  timezone    String      @default("America/Sao_Paulo")

  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String  @db.Char(2)
  latitude     Float
  longitude    Float

  deliveryRadiusKm Float   @default(5)
  minOrderCents    Int     @default(0)
  prepTimeMinutes  Int     @default(30)
  commissionBps    Int? // sobrescreve PlatformSettings.defaultCommissionBps
  paymentAccountId String? // Stripe Connect account / Mercado Pago seller id
  ratingAvg        Float   @default(0)
  ratingCount      Int     @default(0)
  // Cores da marca escolhidas no painel: { primary, success, highlight } em hex. Nulo = padrão.
  theme            Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  categories        StoreCategory[]
  members           StoreMember[]
  openingHours      OpeningHour[]
  productCategories ProductCategory[]
  products          Product[]
  orders            Order[]
  reviews           Review[]

  @@index([status, isOpen])
  @@index([city, status])
  @@index([latitude, longitude])
}

// Categoria de culinária exibida no catálogo (Pizza, Japonesa, Mercado...)
model StoreCategory {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  iconUrl  String?
  position Int     @default(0)

  stores Store[]
}

model StoreMember {
  id        String          @id @default(cuid())
  storeId   String
  userId    String
  role      StoreMemberRole @default(STAFF)
  createdAt DateTime        @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
}

model OpeningHour {
  id        String @id @default(cuid())
  storeId   String
  dayOfWeek Int // 0 = domingo ... 6 = sábado
  opensAt   String // "HH:mm" no fuso da loja
  closesAt  String // pode ser menor que opensAt (vira a madrugada)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, dayOfWeek])
}

// -----------------------------------------------------------------------------
// Cardápio
// -----------------------------------------------------------------------------

model ProductCategory {
  id       String  @id @default(cuid())
  storeId  String
  name     String
  position Int     @default(0)
  isActive Boolean @default(true)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([storeId, position])
}

model Product {
  id             String    @id @default(cuid())
  storeId        String
  categoryId     String?
  name           String
  description    String?
  imageUrl       String?
  priceCents     Int
  compareAtCents Int? // preço "de" para promoções
  isAvailable    Boolean   @default(true)
  position       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  store        Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     ProductCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  optionGroups ProductOptionGroup[]
  orderItems   OrderItem[]

  @@index([storeId, categoryId, position])
  @@index([storeId, isAvailable])
}

// Complementos: "Tamanho" (min 1, max 1), "Adicionais" (min 0, max 5)...
model ProductOptionGroup {
  id        String @id @default(cuid())
  productId String
  name      String
  minSelect Int    @default(0)
  maxSelect Int    @default(1)
  position  Int    @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@index([productId])
}

model ProductOption {
  id          String  @id @default(cuid())
  groupId     String
  name        String
  priceCents  Int     @default(0)
  isAvailable Boolean @default(true)
  position    Int     @default(0)

  group ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

// -----------------------------------------------------------------------------
// Entregadores
// -----------------------------------------------------------------------------

model CourierProfile {
  id              String        @id @default(cuid())
  userId          String        @unique
  taxId           String        @unique // CPF
  vehicleType     VehicleType
  licensePlate    String?
  status          CourierStatus @default(PENDING_APPROVAL)
  isOnline        Boolean       @default(false)
  // Última posição conhecida (a posição "ao vivo" fica no Redis GEO)
  lastLatitude    Float?
  lastLongitude   Float?
  lastSeenAt      DateTime?
  ratingAvg       Float         @default(0)
  ratingCount     Int           @default(0)
  payoutAccountId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, isOnline])
}

// -----------------------------------------------------------------------------
// Pedidos
// -----------------------------------------------------------------------------

model Order {
  id         String      @id @default(cuid())
  code       String      @unique // código curto legível, ex.: "A7K2Q"
  customerId String
  storeId    String
  addressId  String?
  status     OrderStatus @default(PENDING_PAYMENT)

  deliveryAddress Json // snapshot do endereço no momento do pedido
  customerNotes   String?

  subtotalCents    Int
  deliveryFeeCents Int
  serviceFeeCents  Int           @default(0)
  discountCents    Int           @default(0)
  totalCents       Int
  commissionBps    Int // snapshot da comissão aplicada
  commissionCents  Int
  paymentMethod    PaymentMethod
  changeForCents   Int? // "troco para" quando CASH

  estimatedDeliveryAt DateTime?
  placedAt            DateTime?
  acceptedAt          DateTime?
  readyAt             DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer      User                 @relation("CustomerOrders", fields: [customerId], references: [id])
  store         Store                @relation(fields: [storeId], references: [id])
  address       Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  delivery      Delivery?
  payments      Payment[]
  review        Review?

  @@index([storeId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String?
  productName    String // snapshot
  unitPriceCents Int // base + opções, calculado no servidor
  quantity       Int
  totalCents     Int
  options        Json? // snapshot: [{ group, name, priceCents }]
  notes          String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String? // nulo = sistema (webhook, timeout)
  note        String?
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Delivery {
  id        String         @id @default(cuid())
  orderId   String         @unique
  courierId String?
  status    DeliveryStatus @default(WAITING_COURIER)

  pickupLatitude   Float
  pickupLongitude  Float
  dropoffLatitude  Float
  dropoffLongitude Float
  distanceMeters   Int?
  courierFeeCents  Int // valor repassado ao entregador

  confirmationCode String // PIN de 4 dígitos que o cliente informa na entrega
  proofPhotoUrl    String?
  failureReason    String?

  assignedAt       DateTime?
  arrivedAtStoreAt DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier User? @relation("CourierDeliveries", fields: [courierId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([courierId, status])
}

// -----------------------------------------------------------------------------
// Pagamentos
// -----------------------------------------------------------------------------

// Um pedido pode ter várias tentativas (ex.: Pix expirou, cartão recusado).
model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  method            PaymentMethod
  status            PaymentStatus   @default(PENDING)
  amountCents       Int
  refundedCents     Int             @default(0)
  currency          String          @default("BRL") @db.Char(3)
  providerPaymentId String?         @unique // PaymentIntent (Stripe) / payment id (MP)
  idempotencyKey    String          @unique
  pixQrCode         String?         @db.Text
  pixExpiresAt      DateTime?
  failureReason     String?
  rawResponse       Json?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status, createdAt])
}

// Garante processamento idempotente de webhooks (o provedor reenvia eventos).
model WebhookEvent {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime        @default(now())

  @@unique([provider, eventId])
}

// -----------------------------------------------------------------------------
// Avaliações
// -----------------------------------------------------------------------------

model Review {
  id            String   @id @default(cuid())
  orderId       String   @unique
  customerId    String
  storeId       String
  storeRating   Int // 1..5
  courierRating Int? // 1..5 (entregador = order.delivery.courierId)
  comment       String?
  storeReply    String?
  createdAt     DateTime @default(now())

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer User  @relation(fields: [customerId], references: [id])
  store    Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

// -----------------------------------------------------------------------------
// Configuração da plataforma (Super Admin)
// -----------------------------------------------------------------------------

// Linha única (id = 1) com os parâmetros globais.
model PlatformSettings {
  id                    Int      @id @default(1)
  defaultCommissionBps  Int      @default(1200)
  serviceFeeCents       Int      @default(0)
  courierBaseFeeCents   Int      @default(500)
  courierFeePerKmCents  Int      @default(150)
  orderAcceptTimeoutSec Int      @default(300) // auto-cancela se a loja não aceitar
  updatedById           String?
  updatedAt             DateTime @updatedAt
}

// Taxa de entrega cobrada do cliente, por faixa de distância e cidade.
model DeliveryFeeRule {
  id            String   @id @default(cuid())
  name          String
  city          String? // nulo = regra global
  minDistanceKm Float    @default(0)
  maxDistanceKm Float
  baseFeeCents  Int
  feePerKmCents Int      @default(0)
  priority      Int      @default(0) // maior vence em caso de sobreposição
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([city, isActive])
}

// -----------------------------------------------------------------------------
// Notificações e auditoria
// -----------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// Web Push (PWA do entregador e alertas do restaurante)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // "store.approve", "settings.update", "order.refund"
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
